{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-TALK",
  "version": "1.0.0",
  "identifier": "com.aitalk.app",
  "build": {
    "frontendDist": "../../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "AI-TALK · AI 语音陪伴",
        "width": 480,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
